<template>
  <div class="fd-page">
    <!-- 安全区容器：左右内缩同一个 px 值（见 common/device.js safeHorizontalInsetPx） -->
    <div
      class="safe"
      style="padding-left: {{ safeInsetPx }}px; padding-right: {{ safeInsetPx }}px"
    >
      <!-- 头部：官方手表小程序样式 —— 贴顶、居中「‹ 收藏夹名」红色返回，上下不做安全区 -->
      <div class="header">
        <text class="header-back" onclick="goBack">‹ {{ folderTitle }}</text>
      </div>

      <!-- 状态提示 -->
      <text class="state" if="{{ loading }}">加载中…</text>
      <text class="state error" if="{{ error }}" onclick="reload">{{ error }}</text>

      <!-- 曲目列表 -->
      <list class="list" if="{{ tracks.length }}">
        <!-- 播放全部：用当前已加载的曲目建队列，从第 1 首连播，然后回播放器 -->
        <list-item class="play-all" type="playall" onclick="playAll">
          <text class="play-all-text">▶ 播放全部</text>
          <text class="play-all-desc">已加载 {{ tracks.length }} 首</text>
        </list-item>

        <list-item
          for="{{(index, item) in tracks}}"
          class="item"
          onclick="play(index)"
          tid="id"
          type="song"
        >
          <text class="item-index {{ index === currentIndex ? 'item-index-current' : '' }}">
            {{ index === currentIndex ? '♪' : index + 1 }}
          </text>
          <div class="detail">
            <text
              class="item-title"
              style="color: {{ index === currentIndex ? '#ff3a3a' : '#ffffff' }};"
            >{{ item.title }}</text>
            <text class="item-subtitle">{{ item.artist }}</text>
          </div>
          <text class="item-duration">{{ duration(item.duration) }}</text>
        </list-item>

        <list-item class="item load-more" if="{{ hasMore }}" onclick="loadMore" type="more">
          <text class="load-more-text">加载更多…</text>
        </list-item>
      </list>

      <text
        class="state"
        if="{{ !loading && !error && !tracks.length }}"
        onclick="reload"
      >{{ emptyText || '收藏夹是空的' }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router";
import * as biliApi from "../../services/biliApi";
import session from "../../services/session";
import playerService from "../../services/playerService";
import deviceService from "../../services/deviceService";
import { findTrackIndex } from "../../common/tracks";

export default {
  data: {
    // router.push 传入的 params 会注入到本页 data：mediaId / title
    mediaId: 0,
    title: "",
    folderTitle: "",
    tracks: [],
    loading: false,
    error: "",
    emptyText: "",
    hasMore: false,
    currentIndex: -1,
    pn: 1,
    total: 0,
    // 左右安全内缩 px：先按 480 宽矩形屏兜底，getInfo 回来后再重算
    // （机制见 common/device.js 的 safeHorizontalInsetPx 注释）
    safeInsetPx: 29,
  },

  onInit() {
    // 屏幕形状只影响左右内缩 px，先落保守值再刷新（详见 player.ux 同名处注释）
    this.safeInsetPx = deviceService.capabilities().safeInsetPx;
    deviceService.whenReady().then(() => {
      this.safeInsetPx = deviceService.capabilities().safeInsetPx;
    });

    // 路由参数防御性归一：个别 runtime 会把数字参数串成字符串
    this.mediaId = Number(this.mediaId) || 0;
    this.folderTitle = this.title || "收藏夹";

    // 高亮「队列里正在播的是哪一行」：本列表 ≠ 播放队列（解耦），
    // 不能按下标对齐，只能按曲目同一性（bvid/avid）匹配。
    this._unsub = playerService.subscribe((type) => {
      if (type === "track" || type === "queue") this.syncHighlight();
    });

    // 本页是独立 JS VM：先把登录态与共享态读回来。
    // 登录态必须等 —— 本 VM 的 session 是空的，请求就不带 Cookie，
    // 私密收藏夹会被后端判成「不是主人」→ code=-403 访问权限不足。
    session
      .ready()
      .then(() => playerService.adopt())
      .then(() => {
        this.syncHighlight();
        if (!this.mediaId) {
          this.error = "缺少收藏夹参数（请从收藏夹页进入）";
          return;
        }
        this.loadFirstPage();
      });
  },

  onShow() {
    // 从播放器返回时对账一次：队列可能被别的 VM 改过，高亮要跟上
    playerService.adopt().then(() => this.syncHighlight());
  },

  onDestroy() {
    if (this._unsub) {
      this._unsub();
      this._unsub = null;
    }
  },

  /* ---------------------------- 数据加载 ---------------------------- */

  async loadFirstPage() {
    this.loading = true;
    this.error = "";
    this.emptyText = "";
    this.tracks = [];
    this.pn = 1;

    try {
      await this.loadPage(1, true);
    } catch (e) {
      console.error("[FavDetail] 加载失败:", e);
      this.error = this.describeError(e, "加载失败：");
    } finally {
      this.loading = false;
    }
  },

  /**
   * -403 = 该收藏夹需要权限（私密），而后端没认出登录身份。
   * 未登录时给一句人话，别让用户对着 code 发呆。
   */
  describeError(e, prefix) {
    const msg = describe(e);
    if (/-403/.test(msg) && !session.isLoggedIn()) {
      return "该收藏夹需要登录后查看（去「更多」登录）";
    }
    return prefix + msg + "（点击重试）";
  },

  async loadPage(pn, replace) {
    const res = await biliApi.getFavResources(this.mediaId, pn);
    this.total = res.total;
    this.tracks = replace ? res.tracks : this.tracks.concat(res.tracks);
    this.hasMore = res.hasMore;
    this.pn = pn;
    if (!this.tracks.length) {
      this.emptyText = "收藏夹是空的";
    }
    console.log(
      "[FavDetail] 第",
      pn,
      "页加载",
      res.tracks.length,
      "条，累计",
      this.tracks.length,
      "hasMore =",
      res.hasMore
    );
    this.syncHighlight();
  },

  async loadMore() {
    if (this.loading || !this.hasMore) return;
    this.loading = true;
    try {
      await this.loadPage(this.pn + 1, false);
    } catch (e) {
      console.error("[FavDetail] 加载更多失败:", e);
      this.error = "加载更多失败：" + describe(e);
    } finally {
      this.loading = false;
    }
  },

  reload() {
    this.error = "";
    if (!this.mediaId) {
      this.error = "缺少收藏夹参数（请从收藏夹页进入）";
      return;
    }
    this.loadFirstPage();
  },

  /* ---------------------------- 播放（解耦语义） ---------------------------- */

  syncHighlight() {
    // 列表 ≠ 队列：按曲目同一性找「队列里正在播的」在本列表里的位置
    this.currentIndex = findTrackIndex(this.tracks, playerService.getSnapshot().track);
  },

  /**
   * 单曲点播：插到队列当前曲目之后立即播放（队列原有内容保留）。
   * 收藏夹只是选歌入口，播放列表独立演进。
   * 留在本页：可以连续挑几首组一个队列，看完高亮后自己返回。
   */
  async play(index) {
    const track = this.tracks[index];
    if (!track) return;
    await playerService.playTrackNow(track);
    this.syncHighlight();
  },

  /** 播放全部：明确地用这份收藏夹建队列（想连播整个收藏夹时用这个），回播放器 */
  async playAll() {
    if (!this.tracks.length) return;
    await playerService.setQueue(this.tracks, 0);
    // 入口链固定为 player → more → fav → favDetail，回退 3 步到播放器
    router.back({ step: 3 });
  },

  goBack() {
    router.back();
  },

  /** 模板中直接调用：秒 -> m:ss */
  duration(seconds) {
    const s = Math.max(0, Math.floor(Number(seconds) || 0));
    const m = Math.floor(s / 60);
    const rest = s % 60;
    return m + ":" + (rest < 10 ? "0" + rest : rest);
  },
};

function describe(e) {
  if (!e) return "未知错误";
  if (typeof e === "string") return e;
  if (e.message) return e.message;
  if (e.code !== undefined) return "code=" + e.code;
  return JSON.stringify(e);
}
</script>

<style>
.fd-page {
  width: 100%;
  height: 100%;
  padding: 20px 0;
  flex-direction: column;
  align-items: center;
  background-color: black;
}

/* 安全区容器：占满整屏宽，左右内缩是同一个 px 值（模板内联 style 绑定）。
   不用「百分比宽 + 交叉轴居中」的盒子：部分机型上会左锚定。 */
.safe {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
}

/* 头部：贴顶、居中「‹ 收藏夹名」红色返回（官方手表小程序样式，上下不做安全区）。
   收藏夹名可能很长：限一行、超宽省略 */
.header {
  width: 100%;
  height: 64px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.header-back {
  font-size: 30px;
  color: #ff3a3a;
  padding: 8px 20px;
  lines: 1;
  text-overflow: ellipsis;
}

.state {
  width: 100%;
  margin-top: 20px;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.state.error {
  color: #ff8c8c;
}

.list {
  width: 100%;
  margin-top: 10px;
  flex: 1;
}

/* 播放全部行：主题红描边卡片，比普通条目更醒目 */
.play-all {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 88px;
  margin-bottom: 14px;
  padding-left: 20px;
  padding-right: 14px;
  border: 1px solid rgba(255, 58, 58, 0.6);
  border-radius: 18px;
  background-color: rgba(255, 58, 58, 0.12);
}

.play-all-text {
  flex: 1;
  font-size: 30px;
  color: #ff3a3a;
}

.play-all-desc {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.5);
}

.item {
  display: flex;
  width: 100%;
  height: 100px;
  padding-bottom: 8px;
}

.item-index {
  width: 50px;
  height: 100%;
  text-align: center;
  color: white;
  font-size: 26px;
}

.item-index-current {
  color: #ff3a3a;
}

.detail {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.item-title {
  width: 100%;
  font-size: 30px;
  height: 52px;
  line-height: 52px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.item-subtitle {
  width: 100%;
  font-size: 24px;
  height: 40px;
  line-height: 40px;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
  text-overflow: ellipsis;
}

.item-duration {
  width: 80px;
  height: 100%;
  line-height: 100px;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.45);
  text-align: right;
}

.load-more {
  justify-content: center;
  align-items: center;
}

.load-more-text {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.6);
}

/* 胶囊屏（手环 9 / 10）不是本项目的设计目标，这块只是老版本的兜底；
   圆屏安全区不走 @media（对 S1 Pro / Redmi Watch 4 不支持），走 .shape-* class。
   详见 player.ux 同名注释与 common/device.js 顶部说明。 */
@media (shape: pill-shaped) or (max-width: 106) {
  .fd-page {
    padding: 10px;
  }

  .header {
    height: 48px;
  }

  .header-back {
    font-size: 24px;
  }

  .play-all {
    height: 72px;
    border-radius: 12px;
  }

  .play-all-text {
    font-size: 24px;
  }

  .play-all-desc {
    font-size: 18px;
  }

  .item {
    height: 80px;
  }

  .item-index {
    width: 34px;
    font-size: 20px;
  }

  .item-title {
    font-size: 22px;
    height: 42px;
    line-height: 42px;
  }

  .item-subtitle {
    font-size: 18px;
    height: 32px;
    line-height: 32px;
  }

  .item-duration {
    width: 60px;
    line-height: 80px;
    font-size: 16px;
  }

  .state {
    font-size: 18px;
  }
}
</style>
