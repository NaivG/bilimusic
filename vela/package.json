{
  "name": "bilimusic",
  "version": "1.10.1",
  "description": "Another Bilibili Music Player.",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot server --watch --open-nuttx",
    "build": "aiot build",
    "release": "aiot release",
    "watch": "aiot watch --open-nuttx",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify.mjs",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
